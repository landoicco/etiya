<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Local Profile: Plain text on console -->
    <springProfile name="local">
        <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE_TEXT"/>
        </root>
        <logger name="licaza.etiya" level="DEBUG" />
    </springProfile>

    <!-- AWS Profile: JSON structure for CloudWatch -->
    <!-- Declared inside the profile because logstash-logback-encoder is only bundled with prod -->
    <springProfile name="aws|prod">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <!-- Already includes timestamp, level, logger, message, stack trace and MDC -->
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"etiya-core"}</customFields>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>

</configuration>
