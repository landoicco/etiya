meta {
  name: Register Workout Success
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/registerWorkout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "dateTime": "2026-07-24T20:00:00Z",
    "gymId": "gym-golds-sunset",
    "gymName": "Golds Gym Sunset St",
    "exercises": [
      {
        "name": "Barbell Bench Press",
        "sets": [{ "count": 10, "weight": 60.0, "unit": "KG" }]
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}
