meta {
  name: Register Gym Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/registerGym
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Golds Gym Sunset St",
    "location": "Los Angeles, CA",
    "status": "ACTIVE"
  }
}

script:post-response {
  test("Verify Gym ID and exact name", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
    
    const body = res.getBody();
    
    expect(body.id).to.equal("gym-golds-gym-sunset-st");
    expect(body.name).to.equal("Golds Gym Sunset St");
  });

  if (res.body && res.body.id) {
    bru.setVar("generatedGymId", res.body.id);
  }
}

