meta {
  name: Register Exercise Overhead Barbell Press Success
  type: http
}

post {
  url: {{baseUrl}}/exercises
  body: json
  auth: none
}

body:json {
  {
    "name": "Overhead Barbell Press",
    "muscleGroup": "Shoulders"
  }
}

script:post-response {
  test("Verify Exercise ID and exact name", function() {
    expect(res.getStatus()).to.equal(201);

    const body = res.getBody();
    expect(body.id).to.equal("overhead-barbell-press");
    expect(body.name).to.equal("Overhead Barbell Press");
  });
}
