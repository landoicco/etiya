meta {
  name: Register Exercise Barbell Pin Press Success
  type: http
}

post {
  url: {{baseUrl}}/exercises
  body: json
  auth: none
}

body:json {
  {
    "name": "Barbell Pin Press",
    "muscleGroup": "CHEST",
    "category": "PUSH"
  }
}

script:post-response {
  test("Verify Exercise ID and exact name", function() {
    expect(res.getStatus()).to.equal(201);

    const body = res.getBody();
    expect(body.id).to.equal("barbell-pin-press");
    expect(body.name).to.equal("Barbell Pin Press");
    expect(body.category).to.equal("PUSH");
  });
}
