meta {
  name: Register Exercise Barbell Bench Press Success
  type: http
}

post {
  url: {{baseUrl}}/exercises
  body: json
  auth: none
}

body:json {
  {
    "name": "Barbell Bench Press",
    "muscleGroup": "CHEST",
    "category": "PUSH"
  }
}

script:post-response {
  test("Verify Exercise ID and exact name", function() {
    expect(res.getStatus()).to.equal(201);

    const body = res.getBody();
    expect(body.id).to.equal("barbell-bench-press");
    expect(body.name).to.equal("Barbell Bench Press");
    expect(body.category).to.equal("PUSH");
  });
}
