meta {
  name: Register Shared Exercise Not Admin Error
  type: http
}

post {
  url: {{baseUrl}}/catalog/exercises
  body: json
  auth: none
}

headers {
  X-User-Id: user-without-workouts
  Authorization: Bearer {{otherAuthToken}}
}

body:json {
  {
    "name": "Seal Row",
    "muscleGroup": "BACK",
    "category": "PULL"
  }
}

script:post-response {
  // The second user, who is never in the admins group in either environment
  test("Should refuse a write to the shared catalog from outside the admins group", function() {
    expect(res.getStatus()).to.equal(403);

    const body = res.getBody();
    expect(body.error).to.equal("FORBIDDEN");
  });
}
