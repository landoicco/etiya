meta {
  name: Register Gym Success
  type: http
}

post {
  url: {{baseUrl}}/gyms
  body: json
  auth: none
}

body:json {
  {
    "name": "Golds Gym",
    "branch": "Sunset St",
    "city": "Los Angeles"
  }
}

script:post-response {
  test("Verify Gym registration success", function() {
    expect(res.getStatus()).to.equal(201);

    const body = res.getBody();
    expect(body.id).to.equal("golds-gym-sunset-st-los-angeles");
    expect(body.name).to.equal("Golds Gym");
    expect(body.branch).to.equal("Sunset St");
    expect(body.city).to.equal("Los Angeles");
  });
}
