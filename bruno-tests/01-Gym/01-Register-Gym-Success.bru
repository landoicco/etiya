meta {
  name: Register Gym Success
  type: http
}

post {
  url: {{baseUrl}}/gyms
  body: json
  auth: none
}

body:json {
  {
    "name": "Golds Gym Sunset St",
    "location": "Los Angeles, CA"
  }
}

script:post-response {
  test("Verify Gym registration success", function() {
    expect(res.getStatus()).to.equal(201);

    const body = res.getBody();
    expect(body.id).to.equal("golds-gym-sunset-st");
    expect(body.name).to.equal("Golds Gym Sunset St");
  });
}
