meta {
  name: Register Gym Missing Name Error
  type: http
}

post {
  url: {{baseUrl}}/gyms
  body: json
  auth: none
}

body:json {
  {
    "location": "Los Angeles, CA"
  }
}

script:post-response {
  test("Verify Validation Error on missing gym name", function() {
    expect(res.getStatus()).to.equal(400);

    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.error).to.equal("VALIDATION_ERROR");
    expect(body.message).to.contain("Gym name cannot be blank");
    expect(body.path).to.equal("/gyms");
    expect(body.timestamp).to.not.be.undefined;
  });
}
