meta {
  name: Search Gyms Success
  type: http
}

post {
  url: {{baseUrl}}/searchGyms
  body: text
  auth: none
}

headers {
  Content-Type: text/plain
}

body:text {
  Golds Gym
}

script:post-response {
  test("Should find the gym by case-insensitive name prefix", function() {
    expect(res.getStatus()).to.equal(200);

    let body = res.getBody();
    if (typeof body === 'string') {
      body = JSON.parse(body);
    }

    expect(body).to.be.an('array');
    expect(body.map(g => g.id)).to.include("golds-gym-sunset-st");
  });
}
