meta {
  name: Register Workout With Valid Exercise
  type: http
  seq: 6
}

post {
  url: http://localhost:8080/registerWorkout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "dateTime": "2026-07-24T21:00:00Z",
    "gymId": "gym-golds-sunset",
    "gymName": "Golds Gym Sunset St",
    "exercises": [
      {
        "exerciseCatalogItemId": "exe-leg-press",
        "name": "Leg Press",
        "sets": [
          { "count": 12, "weight": 150.0, "unit": "KG" }
        ]
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}
