meta {
  name: Register Gym Success
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/registerGym
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "golds-sunset",
    "name": "Golds Gym Sunset St",
    "location": "LA, California"
  }
}

assert {
  res.status: eq 200
}
