meta {
  name: Register Workout Weight Without Unit Error
  type: http
}

post {
  url: {{baseUrl}}/me/workouts
  body: json
  auth: none
}

headers {
  X-User-Id: {{userId}}
}

body:json {
  {
    "startedAt": "2026-08-03T18:00:00Z",
    "endedAt": "2026-08-03T19:00:00Z",
    "exercises": [
      {
        "name": "Pull-ups",
        "sets": [
          { "count": 8, "weight": 10, "unit": "NONE" }
        ]
      }
    ]
  }
}

script:post-response {
  test("Should reject a weight on a set without weight", function() {
    expect(res.getStatus()).to.equal(400);

    const body = res.getBody();
    expect(body.error).to.equal("VALIDATION_ERROR");
    expect(body.message).to.contain("Weight must be 0 when the unit is NONE");
  });
}
