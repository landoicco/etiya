meta {
  name: Get My Workouts Success
  type: http
}

get {
  url: {{baseUrl}}/me/workouts
  body: none
  auth: none
}

headers {
  X-User-Id: {{userId}}
}

script:post-response {
  test("Should retrieve the user's workouts, newest first", function() {
    expect(res.getStatus()).to.equal(200);

    const items = res.getBody().items;
    expect(items.length).to.be.at.least(2);
    items.forEach(w => expect(w.userId).to.equal(bru.getEnvVar("userId")));

    for (let i = 1; i < items.length; i++) {
      expect(items[i - 1].startedAt >= items[i].startedAt).to.be.true;
    }
  });
}
