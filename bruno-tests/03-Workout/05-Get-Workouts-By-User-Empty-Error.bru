meta {
  name: Get Workouts By User Empty Error
  type: http
}

post {
  url: {{baseUrl}}/getWorkoutsByUserId
  body: none
  auth: none
}

headers {
  Content-Type: text/plain
}

script:post-response {
  test("Should return 400 on blank user ID", function() {
    expect(res.getStatus()).to.equal(200);

    const businessStatus = res.getHeader("statuscode");
    expect(Number(businessStatus)).to.equal(400);

    let body = res.getBody();
    if (typeof body === 'string') {
      body = JSON.parse(body);
    }

    expect(body.status).to.equal(400);
    expect(body.error).to.equal("VALIDATION_ERROR");
    expect(body.message).to.contain("User ID cannot be blank");
  });
}
