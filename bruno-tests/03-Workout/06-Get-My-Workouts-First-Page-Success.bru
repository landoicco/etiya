meta {
  name: Get My Workouts First Page Success
  type: http
}

get {
  url: {{baseUrl}}/me/workouts?limit=1
  body: none
  auth: none
}

params:query {
  limit: 1
}

headers {
  X-User-Id: {{userId}}
}

script:post-response {
  test("Should return one workout and a cursor to the next page", function() {
    expect(res.getStatus()).to.equal(200);

    const body = res.getBody();
    expect(body.items.length).to.equal(1);
    expect(body.nextCursor).to.be.a('string');
  });

  const body = res.getBody();
  if (body && body.nextCursor) {
    bru.setVar("workoutsCursor", body.nextCursor);
    bru.setVar("firstPageWorkoutId", body.items[0].id);
  }
}
