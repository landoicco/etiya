meta {
  name: Register Workout Missing Time Zone Error
  type: http
}

post {
  url: {{baseUrl}}/me/workouts
  body: json
  auth: none
}

headers {
  X-User-Id: {{userId}}
}

body:json {
  {
    "startedAt": "2026-07-31T18:30:00",
    "endedAt": "2026-07-31T19:45:00Z",
    "exercises": [
      {
        "name": "Barbell Bench Press",
        "sets": [
          { "count": 12, "weight": 60.0, "unit": "KG" }
        ]
      }
    ]
  }
}

script:post-response {
  test("Should reject a date-time without a time zone", function() {
    expect(res.getStatus()).to.equal(400);

    const body = res.getBody();
    expect(body.error).to.equal("VALIDATION_ERROR");
    expect(body.message).to.contain("startedAt must be an ISO-8601 date-time with a time zone");
  });
}
