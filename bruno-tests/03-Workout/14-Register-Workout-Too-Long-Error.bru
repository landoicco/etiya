meta {
  name: Register Workout Too Long Error
  type: http
}

post {
  url: {{baseUrl}}/me/workouts
  body: json
  auth: none
}

headers {
  X-User-Id: {{userId}}
}

body:json {
  {
    "startedAt": "2026-08-01T06:00:00Z",
    "endedAt": "2026-08-01T18:00:01Z",
    "exercises": [
      {
        "name": "Barbell Bench Press",
        "sets": [
          { "count": 12, "weight": 60.0, "unit": "KG" }
        ]
      }
    ]
  }
}

script:post-response {
  test("Should reject a workout longer than 12 hours", function() {
    expect(res.getStatus()).to.equal(400);

    const body = res.getBody();
    expect(body.error).to.equal("VALIDATION_ERROR");
    expect(body.message).to.contain("A workout cannot last more than 12 hours");
  });
}
