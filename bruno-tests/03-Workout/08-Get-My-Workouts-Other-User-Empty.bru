meta {
  name: Get My Workouts Other User Empty
  type: http
}

get {
  url: {{baseUrl}}/me/workouts
  body: none
  auth: none
}

headers {
  X-User-Id: user-without-workouts
  Authorization: Bearer {{otherAuthToken}}
}

script:post-response {
  // A second identity, expressed the way each environment understands one: locally the
  // bridge fakes the sub from X-User-Id and ignores the token, on AWS the token is the
  // identity and the header is inert. Overrides the collection's Authorization
  test("Should only return the caller's own workouts", function() {
    expect(res.getStatus()).to.equal(200);

    const body = res.getBody();
    expect(body.items).to.be.an('array').that.is.empty;
    expect(body.nextCursor).to.equal(null);
  });
}
