meta {
  name: Register Workout Success
  type: http
}

post {
  url: {{baseUrl}}/me/workouts
  body: json
  auth: none
}

headers {
  X-User-Id: {{userId}}
}

body:json {
  {
    "startedAt": "2026-07-31T18:30:00Z",
    "endedAt": "2026-07-31T19:45:00Z",
    "gymId": "golds-gym-sunset-st-los-angeles",
    "gymName": "Golds Gym Sunset St",
    "exercises": [
      {
        "exerciseCatalogItemId": "barbell-bench-press",
        "name": "Barbell Bench Press",
        "sets": [
          { "count": 12, "weight": 60.0, "unit": "KG" },
          { "count": 10, "weight": 80.0, "unit": "KG" }
        ]
      },
      {
        "name": "Overhead Barbell Press",
        "sets": [
          { "count": 10, "weight": 40.0, "unit": "KG" }
        ]
      }
    ]
  }
}

script:post-response {
  test("Should store the workout under the authenticated user", function() {
    expect(res.getStatus()).to.equal(201);

    const body = res.getBody();
    // A ULID: 26 Crockford base32 characters
    expect(body.id).to.match(/^[0-9A-HJKMNP-TV-Z]{26}$/);
    expect(body.userId).to.equal(bru.getEnvVar("userId"));
    expect(body.gymId).to.equal("golds-gym-sunset-st-los-angeles");
    expect(body.startedAt).to.equal("2026-07-31T18:30:00Z");
    expect(body.endedAt).to.equal("2026-07-31T19:45:00Z");
    expect(body.exercises.length).to.equal(2);
  });

  const body = res.getBody();
  if (body && body.id) {
    bru.setVar("registeredWorkoutId", body.id);
  }
}
