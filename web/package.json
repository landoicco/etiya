{
  "name": "etiya-web",
  "private": true,
  "version": "1.4.0",
  "description": "Etiya's web app: a PWA to log gym workouts one-handed, offline",
  "author": "Lando Icaza (https://github.com/landoicco)",
  "license": "MIT",
  "homepage": "https://github.com/landoicco/etiya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/landoicco/etiya.git",
    "directory": "web"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000 --strictPort",
    "config": "scripts/config.sh public/config.json",
    "deploy": "scripts/deploy.sh",
    "deploy:art": "scripts/deploy-art.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "aws-amplify": "^6.22.2",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
