<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- Independent from core: infrastructure dependencies never reach the Lambda jar -->
  <groupId>licaza.etiya</groupId>
  <artifactId>infra</artifactId>
  <!-- Deployed with the API, so it follows the api-v* tags too -->
  <version>1.0.0</version>
  <name>Etiya infrastructure</name>
  <description>AWS CDK app that defines Etiya's stacks: API, Cognito, DynamoDB and the web app's hosting</description>
  <url>https://github.com/landoicco/etiya</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Lando Icaza</name>
      <url>https://github.com/landoicco</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/landoicco/etiya.git</connection>
    <developerConnection>scm:git:git@github.com:landoicco/etiya.git</developerConnection>
    <url>https://github.com/landoicco/etiya</url>
  </scm>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <aws-cdk-lib.version>2.271.0</aws-cdk-lib.version>
    <constructs.version>10.8.1</constructs.version>
    <cdk-nag.version>3.0.2</cdk-nag.version>
    <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>software.amazon.awscdk</groupId>
      <artifactId>aws-cdk-lib</artifactId>
      <version>${aws-cdk-lib.version}</version>
    </dependency>
    <dependency>
      <groupId>software.constructs</groupId>
      <artifactId>constructs</artifactId>
      <version>${constructs.version}</version>
    </dependency>
    <!-- Checks the stack against AWS security rules on every synth -->
    <dependency>
      <groupId>io.github.cdklabs</groupId>
      <artifactId>cdknag</artifactId>
      <version>${cdk-nag.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- cdk.json runs the app through this plugin -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <mainClass>licaza.etiya.infra.EtiyaApp</mainClass>
        </configuration>
      </plugin>
      <!-- Same formatting rules as core -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.3</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>1.17.0</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports />
            <endWithNewline />
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
